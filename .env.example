CLOUDFLARE_API_TOKEN=
# Or read the token from a file, such as a Docker secret (set only one)
# CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_token
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_RECORD_ID=
CLOUDFLARE_RECORD_NAME=
# Optional: where the health endpoint listens (default 127.0.0.1:8080)
# HEALTH_ADDR=127.0.0.1:8080
# Optional: how often to check the public IP, as a Go duration, 30s to 24h (default 5m)
# SYNC_INTERVAL=5m
# Optional: record TTL in seconds, 1 for automatic or 30-86400 (default 300)
# CLOUDFLARE_RECORD_TTL=300
# Optional: public IP providers to try, in order
# (cloudflare, amazon, akamai, opendns, ripe, hetzner, mullvad, ipinfo, ipify, icanhazip)
# IP_PROVIDERS=cloudflare,amazon,akamai,opendns,ripe,hetzner,mullvad,ipinfo,ipify,icanhazip
